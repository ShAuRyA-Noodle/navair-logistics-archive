# npm run setup generates local database credentials in ignored .env.local.
DATABASE_URL=postgresql://navair_app:LOCAL_PASSWORD@127.0.0.1:55439/navair_local
# Used only by migrations, seeding, and disposable database tests; never by application request handlers.
ADMIN_DATABASE_URL=postgresql://navair_owner:LOCAL_PASSWORD@127.0.0.1:55439/navair_local
APP_URL=http://127.0.0.1:3000
LOCAL_DEMO_MODE=true
MAIL_MODE=preview
BUSINESS_EMAIL=operations@navair.example
MAIL_FROM=Navair Logistics <enquiries@navair.example>
# Optional worker principal. Local demo can discover the seeded owner automatically.
WORKER_ACTOR_ID=
# Configure only in an isolated real-data environment after domain/provider setup.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Server-only website chat configuration. Create a key at console.groq.com.
GROQ_API_KEY=
# Optional override. Defaults to Groq's openai/gpt-oss-20b production model.
GROQ_MODEL=
