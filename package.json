{
  "name": "navair-logistics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test.ts",
    "db:start": "tsx scripts/local-db.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "setup": "npm run db:start && npm run db:migrate && npm run db:seed",
    "local": "npm run setup && tsx scripts/local.ts",
    "worker": "tsx scripts/worker.ts",
    "data:import": "tsx scripts/import-data.ts",
    "test:smoke": "tsx scripts/smoke.ts",
    "db:export": "tsx scripts/export-db.ts",
    "news:sweep": "tsx scripts/news-ingest.ts",
    "news:cron": "tsx scripts/news-cron.ts"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@supabase/ssr": "0.12.6",
    "@supabase/supabase-js": "2.116.0",
    "dotenv": "17.4.2",
    "gsap": "3.15.0",
    "matter-js": "0.20.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.26.0",
    "three": "0.186.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/matter-js": "0.20.2",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
